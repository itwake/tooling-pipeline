// mvn-rebundle / consumer: propose the POM change of a project that will consume a bundle.
//
// The bundle comes either from an mvn-rebundle build (its archived bundle-manifest.json and
// dependency-reduced POM are copied with the Copy Artifact plugin) or from explicit coordinates
// (BUNDLE_COORDINATES + EMBEDDED_COORDINATES) for a bundle that already exists in Nexus.
// With CONSUMER_GIT_URL the consumer project is checked out and `dependency:tree -Dverbose` runs
// there, so the proposal lists the exclusions per module and per path. Without it the proposal
// contains the generic snippets and the commands to produce the tree.
//
// Agent requirements (Linux): Python 3.8+; Maven 3.6+ and JDK when CONSUMER_GIT_URL is used.
// Plugins: Copy Artifact (unless BUNDLE_COORDINATES is used), Git, Credentials Binding.
// The upstream job may need "Permission to Copy Artifact" granted to this job.
// Job setup: "Pipeline script from SCM", Script Path = jenkins/Jenkinsfile.consumer.

def withNexusCredentials(Closure body) {
    if (env.NEXUS_CREDENTIALS_ID?.trim()) {
        withCredentials([usernamePassword(credentialsId: env.NEXUS_CREDENTIALS_ID,
                                          usernameVariable: 'NEXUS_USERNAME',
                                          passwordVariable: 'NEXUS_PASSWORD')]) {
            body()
        }
    } else {
        body()
    }
}

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(name: 'UPSTREAM_JOB', defaultValue: 'mvn-rebundle', description: 'Name of the mvn-rebundle build job to take the bundle from')
        string(name: 'UPSTREAM_BUILD', defaultValue: '', description: 'Build number of that job; empty = last successful build')
        string(name: 'BUNDLE_COORDINATES', defaultValue: '',
               description: 'Alternative to the upstream build: groupId:artifactId:version of an existing bundle')
        text(name: 'EMBEDDED_COORDINATES', defaultValue: '',
             description: 'With BUNDLE_COORDINATES: the coordinates embedded in that bundle, one groupId:artifactId:version per line')
        string(name: 'CONSUMER_GIT_URL', defaultValue: '', description: 'Optional: git URL of the consumer project; enables the per-path exclusion list')
        string(name: 'CONSUMER_GIT_REF', defaultValue: 'main', description: 'Consumer branch, tag or commit')
        string(name: 'CONSUMER_MAVEN_ARGS', defaultValue: '', description: 'Extra arguments for the consumer dependency:tree run, e.g. -Pprod')
    }

    environment {
        // ---- site specific: edit once -------------------------------------------------------
        NEXUS_CREDENTIALS_ID = ''               // only needed when MAVEN_MIRROR_URL requires authentication
        MAVEN_MIRROR_URL     = ''               // company Maven group repository used for the consumer dependency:tree; empty = Maven Central
        GIT_CREDENTIALS_ID   = ''               // optional: credential ID for checking out CONSUMER_GIT_URL
        // -----------------------------------------------------------------------------------
        PY = 'python3'
    }

    stages {
        stage('Prepare') {
            steps {
                sh 'rm -rf work out && mkdir -p work out && "$PY" --version'
                writeFile file: 'work/embedded.txt', text: params.EMBEDDED_COORDINATES
                sh '"$PY" scripts/gen_maven_settings.py --server-id nexus --mirror-url "$MAVEN_MIRROR_URL" --out work/settings.xml'
            }
        }

        stage('Bundle from upstream build') {
            when { expression { !params.BUNDLE_COORDINATES?.trim() } }
            steps {
                script {
                    def selector = params.UPSTREAM_BUILD?.trim() ? specific(params.UPSTREAM_BUILD.trim()) : lastSuccessful()
                    copyArtifacts(projectName: params.UPSTREAM_JOB, selector: selector, fingerprintArtifacts: true,
                                  filter: 'out/bundle-manifest.json, work/bundle/target/dependency-reduced-pom.xml')
                }
                sh 'test -f out/bundle-manifest.json || { echo "bundle-manifest.json not found in the upstream build"; exit 1; }'
            }
        }

        stage('Consumer dependency tree') {
            when { expression { params.CONSUMER_GIT_URL?.trim() } }
            steps {
                dir('work/consumer') {
                    checkout([$class: 'GitSCM',
                              branches: [[name: params.CONSUMER_GIT_REF]],
                              userRemoteConfigs: [[url: params.CONSUMER_GIT_URL,
                                                   credentialsId: (env.GIT_CREDENTIALS_ID?.trim() ?: null)]]])
                    script {
                        withNexusCredentials {
                            sh '''
                                mvn -B -ntp -s "$WORKSPACE/work/settings.xml" \
                                    org.apache.maven.plugins:maven-dependency-plugin:3.7.1:tree \
                                    -Dverbose -DoutputType=text -DappendOutput=true \
                                    -DoutputFile="$WORKSPACE/out/consumer-dependency-tree.txt" $CONSUMER_MAVEN_ARGS
                            '''
                        }
                    }
                }
            }
        }

        stage('Patch proposal') {
            steps {
                sh '''
                    ARGS=""
                    if [ -f out/consumer-dependency-tree.txt ]; then ARGS="--tree out/consumer-dependency-tree.txt"; fi
                    if [ -n "$BUNDLE_COORDINATES" ]; then
                        "$PY" scripts/gen_consumer_patch.py --bundle "$BUNDLE_COORDINATES" --embedded-file work/embedded.txt $ARGS \
                            --out out/consumer-patch.md --out-json out/consumer-patch.json
                    else
                        "$PY" scripts/gen_consumer_patch.py --manifest out/bundle-manifest.json \
                            --reduced-pom work/bundle/target/dependency-reduced-pom.xml $ARGS \
                            --out out/consumer-patch.md --out-json out/consumer-patch.json
                    fi
                '''
            }
        }
    }

    post {
        always {
            sh '"$PY" scripts/write_summary.py --out-dir out || true'
            archiveArtifacts artifacts: 'out/**', allowEmptyArchive: true
        }
    }
}
