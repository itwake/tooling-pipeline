// mvn-rebundle / consumer: propose, and on request apply, the POM change of a project that will
// consume a bundle.
//
// The bundle comes from an mvn-rebundle build (its archived bundle-manifest.json and published POM are
// copied with the Copy Artifact plugin) or, with BUNDLE_COORDINATES, from Nexus (the bundle jar and its
// POM are downloaded; the jar's manifest lists what it embeds). With CONSUMER_GIT_URL the consumer
// project is checked out and `dependency:tree -Dverbose` runs there, so the proposal lists the
// exclusions per module and per path; without it the proposal holds the generic snippets. The build
// plugins are covered too: `help:effective-pom` lists the plugins every module uses (declared ones and
// lifecycle defaults), plugin_trees.py turns them into a throwaway reactor whose dependency trees show each
// plugin's class realm, and a plugin whose realm contains an embedded coordinate gets the bundle as its
// first dependency, the coordinate removed or excluded where Maven allows it (config/policy.json, plugins).
//
// APPLY=true turns the proposal into a branch of the consumer project: the POMs are edited in place
// (formatting and comments preserved), the project is built with the Enforcer gate, the rebuilt Spring
// Boot archive is compared with the artifact the bundle was built from, and the branch is pushed for
// review. The comparison lists every difference (third-party jars and their contents, the project's own
// modules and classes) and whether both builds come from the same commit, but decides nothing:
// ON_DIFFERENCES says whether to ask (input step listing the findings), push anyway or stop. Nothing is
// merged automatically.
//
// Agent requirements (Linux): Python 3.8+; Maven 3.6+ and a JDK when CONSUMER_GIT_URL is used;
// docker or crane (and the aws CLI for ECR) when the original artifact is an image.
// Plugins: Copy Artifact (unless BUNDLE_COORDINATES is used), Git, Credentials Binding.
// The upstream job may need "Permission to Copy Artifact" granted to this job.
// Job setup: "Pipeline script from SCM", Script Path = jenkins/Jenkinsfile.consumer.

def withNexusCredentials(Closure body) {
    if (env.NEXUS_CREDENTIALS_ID?.trim()) {
        withCredentials([usernamePassword(credentialsId: env.NEXUS_CREDENTIALS_ID,
                                          usernameVariable: 'NEXUS_USERNAME',
                                          passwordVariable: 'NEXUS_PASSWORD')]) {
            body()
        }
    } else {
        body()
    }
}

// Credentials needed to read a source artifact; `auth` is what `extract_source.py --detect` printed.
def withSourceCredentials(String auth, Closure body) {
    if (auth == 'ecr' && env.AWS_CREDENTIALS_ID?.trim()) {
        withCredentials([aws(credentialsId: env.AWS_CREDENTIALS_ID,
                             accessKeyVariable: 'AWS_ACCESS_KEY_ID', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {
            body()
        }
    } else if (auth == 'nexus' && env.SOURCE_CREDENTIALS_ID?.trim()) {
        withCredentials([usernamePassword(credentialsId: env.SOURCE_CREDENTIALS_ID,
                                          usernameVariable: 'SOURCE_USERNAME', passwordVariable: 'SOURCE_PASSWORD')]) {
            body()
        }
    } else {
        body()
    }
}

// Detects one reference, binds the credentials it needs and extracts it to work/<label>.
def fetchSource(String label, String ref) {
    withEnv(["FETCH_REF=${ref}", "FETCH_LABEL=${label}"]) {
        def detected = sh(returnStdout: true,
                          script: '"$PY" scripts/extract_source.py --detect --ref "$FETCH_REF" --nexus-hosts "$NEXUS_HOSTS"').trim()
        echo "${label} source detected: ${detected}"
        withSourceCredentials(detected.tokenize()[1]) {
            sh '''
                "$PY" scripts/extract_source.py --ref "$FETCH_REF" --path "$DEFAULT_APP_PATH" --nexus-hosts "$NEXUS_HOSTS" \
                    --image-tool "$IMAGE_TOOL" --platform "$IMAGE_PLATFORM" --maven-repo-url "$NEXUS_MAVEN_REPO_URL" \
                    --out "work/$FETCH_LABEL" --meta "out/$FETCH_LABEL-source.json"
            '''
        }
    }
}

// Findings of the comparison with the original artifact, one per line, prefixed [dependencies],
// [application] or [info]; empty when the comparison did not run or found nothing.
def equivalenceFindings() {
    if (!fileExists('out/equivalence-findings.txt')) {
        return []
    }
    return readFile('out/equivalence-findings.txt').tokenize('\n').findAll { it.trim() }
}

// Findings of the plugin dependency check after the patch, prefixed [plugins]; empty when it did not run.
def pluginFindings() {
    if (!fileExists('out/plugin-trees-findings.txt')) {
        return []
    }
    return readFile('out/plugin-trees-findings.txt').tokenize('\n').findAll { it.trim() }
}

// Git over https with a username/password credential; ssh remotes rely on the agent's keys.
def withGitCredentials(Closure body) {
    if (env.GIT_CREDENTIALS_ID?.trim()) {
        withCredentials([usernamePassword(credentialsId: env.GIT_CREDENTIALS_ID,
                                          usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_PASSWORD')]) {
            sh '''
                cat > work/git-askpass.sh <<'EOF'
#!/bin/sh
case "$1" in
  Username*) printf '%s\\n' "$GIT_USERNAME" ;;
  Password*) printf '%s\\n' "$GIT_PASSWORD" ;;
esac
EOF
                chmod +x work/git-askpass.sh
            '''
            withEnv(["GIT_ASKPASS=${env.WORKSPACE}/work/git-askpass.sh", 'GIT_TERMINAL_PROMPT=0']) {
                body()
            }
        }
    } else {
        body()
    }
}

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 60, unit: 'MINUTES')
    }

    parameters {
        string(name: 'UPSTREAM_BUILD', defaultValue: '', description: 'Build number of the UPSTREAM_JOB run to take the bundle from; empty = last successful build')
        string(name: 'BUNDLE_COORDINATES', defaultValue: '',
               description: 'Alternative to the upstream build: groupId:artifactId:version of a bundle already published to Nexus')
        string(name: 'CONSUMER_GIT_URL', defaultValue: '', description: 'Git URL of the consumer project; enables the per-path exclusion list and APPLY')
        string(name: 'CONSUMER_GIT_REF', defaultValue: 'main', description: 'Consumer branch, tag or commit')
        string(name: 'CONSUMER_MAVEN_ARGS', defaultValue: '', description: 'Extra arguments for the consumer dependency:tree run, e.g. -Pprod')
        booleanParam(name: 'APPLY', defaultValue: false,
                     description: 'Edit the consumer POMs on a branch, build with the Enforcer gate, compare the rebuilt archive with the original artifact and push the branch for review')
        string(name: 'VERIFY_AGAINST', defaultValue: '',
               description: 'APPLY: artifact to compare the rebuilt archive with (image reference, coordinates, URL or agent path); empty = the artifact the bundle was built from')
    }

    environment {
        // ---- site specific: edit once -------------------------------------------------------
        UPSTREAM_JOB          = 'mvn-rebundle'   // name of the build job whose archives hold bundle-manifest.json
        NEXUS_MAVEN_REPO_URL  = 'https://nexus.example.com/repository/maven-public/'   // bundle coordinates and the original artifact are resolved here
        NEXUS_DOCKER_REGISTRY = 'nexus-docker.example.com'   // host[:port] of the Nexus Docker registry (original artifact as an image)
        SOURCE_CREDENTIALS_ID = 'nexus-deploy'   // Nexus credential for downloading the bundle / the original artifact
        AWS_CREDENTIALS_ID    = ''               // original artifact in ECR: AWS credential ID; empty = the agent's instance role
        NEXUS_CREDENTIALS_ID  = ''               // only needed when MAVEN_MIRROR_URL requires authentication
        MAVEN_MIRROR_URL      = ''               // Maven mirror for the consumer builds; empty = Maven Central
        GIT_CREDENTIALS_ID    = ''               // username/password credential with push rights on CONSUMER_GIT_URL (https); empty = agent keys
        GIT_USER_NAME         = 'mvn-rebundle'
        GIT_USER_EMAIL        = 'mvn-rebundle@example.com'
        CONSUMER_BUILD_ARGS   = '-DskipTests'    // APPLY: arguments of the consumer build (`mvn ... verify`)
        PUSH_BRANCH           = 'true'           // APPLY: push the branch to the consumer repository
        ON_DIFFERENCES        = 'ask'            // APPLY, the rebuilt application differs from the original artifact: ask (input step), push (push, build UNSTABLE), stop (no push)
        ON_DIFFERENCES_TIMEOUT = '60'            // minutes to wait for the answer when ON_DIFFERENCES=ask; no answer = not pushed
        DEFAULT_APP_PATH      = '/app/app.jar'   // original artifact as an image: application path inside it
        IMAGE_PLATFORM        = ''
        IMAGE_TOOL            = 'auto'
        // -----------------------------------------------------------------------------------
        NEXUS_HOSTS = "${NEXUS_DOCKER_REGISTRY},${NEXUS_MAVEN_REPO_URL}"
        PY = 'python3'
    }

    stages {
        stage('Prepare') {
            steps {
                sh '''
                    rm -rf work out && mkdir -p work out
                    echo "mvn-rebundle revision: $(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
                    "$PY" --version
                '''
                sh '"$PY" scripts/gen_maven_settings.py --server-id nexus --mirror-url "$MAVEN_MIRROR_URL" --out work/settings.xml'
            }
        }

        stage('Bundle from upstream build') {
            when { expression { !params.BUNDLE_COORDINATES?.trim() } }
            steps {
                script {
                    def selector = params.UPSTREAM_BUILD?.trim() ? specific(params.UPSTREAM_BUILD.trim()) : lastSuccessful()
                    copyArtifacts(projectName: env.UPSTREAM_JOB, selector: selector, fingerprintArtifacts: true,
                                  filter: 'out/bundle-manifest.json, work/bundle/target/*.pom, work/bundle/target/dependency-reduced-pom.xml')
                }
                sh 'test -f out/bundle-manifest.json || { echo "bundle-manifest.json not found in the upstream build"; exit 1; }'
            }
        }

        stage('Bundle from Nexus') {
            when { expression { params.BUNDLE_COORDINATES?.trim() } }
            steps {
                script {
                    withSourceCredentials('nexus') {
                        sh '''
                            "$PY" scripts/extract_source.py --ref "$BUNDLE_COORDINATES" --nexus-hosts "$NEXUS_HOSTS" \
                                --maven-repo-url "$NEXUS_MAVEN_REPO_URL" --out work/bundle-jar --meta out/bundle-jar-source.json
                            "$PY" scripts/extract_source.py --ref "$BUNDLE_COORDINATES:pom" --nexus-hosts "$NEXUS_HOSTS" \
                                --maven-repo-url "$NEXUS_MAVEN_REPO_URL" --out work/bundle-pom --meta out/bundle-pom-source.json
                        '''
                    }
                }
            }
        }

        stage('Consumer dependency tree') {
            when { expression { params.CONSUMER_GIT_URL?.trim() } }
            steps {
                dir('work/consumer') {
                    checkout([$class: 'GitSCM',
                              branches: [[name: params.CONSUMER_GIT_REF]],
                              userRemoteConfigs: [[url: params.CONSUMER_GIT_URL,
                                                   credentialsId: (env.GIT_CREDENTIALS_ID?.trim() ?: null)]]])
                    script {
                        withNexusCredentials {
                            sh '''
                                mvn -B -ntp -s "$WORKSPACE/work/settings.xml" \
                                    org.apache.maven.plugins:maven-dependency-plugin:3.7.1:tree \
                                    -Dverbose -DoutputType=text -DappendOutput=true \
                                    -DoutputFile="$WORKSPACE/out/consumer-dependency-tree.txt" $CONSUMER_MAVEN_ARGS
                                mvn -B -ntp -s "$WORKSPACE/work/settings.xml" \
                                    org.apache.maven.plugins:maven-help-plugin:3.4.1:effective-pom \
                                    -Doutput="$WORKSPACE/out/consumer-effective-pom.xml" $CONSUMER_MAVEN_ARGS
                            '''
                        }
                    }
                }
                // the build plugins: a throwaway reactor with one module per plugin configuration, whose
                // dependency trees are the plugins' class realms
                script {
                    withNexusCredentials {
                        sh '''
                            "$PY" scripts/plugin_trees.py --effective-pom out/consumer-effective-pom.xml \
                                --reactor work/plugin-trees --plugins-out out/consumer-plugins.json
                            mvn -B -ntp -s "$WORKSPACE/work/settings.xml" -f work/plugin-trees/pom.xml \
                                org.apache.maven.plugins:maven-dependency-plugin:3.7.1:tree \
                                -Dverbose -DoutputType=text -DappendOutput=true \
                                -DoutputFile="$WORKSPACE/out/consumer-plugin-trees.txt"
                        '''
                    }
                }
            }
        }

        stage('Patch proposal') {
            steps {
                sh '''
                    ARGS=""
                    if [ -f out/consumer-dependency-tree.txt ]; then ARGS="--tree out/consumer-dependency-tree.txt"; fi
                    if [ -f out/consumer-plugin-trees.txt ] && [ -f out/consumer-plugins.json ]; then
                        ARGS="$ARGS --plugin-tree out/consumer-plugin-trees.txt --plugins out/consumer-plugins.json"
                    fi
                    if [ -n "$BUNDLE_COORDINATES" ]; then
                        JAR=$(ls work/bundle-jar/*.jar | head -1)
                        POM=$(ls work/bundle-pom/*.pom | head -1)
                        "$PY" scripts/gen_consumer_patch.py --bundle-jar "$JAR" --reduced-pom "$POM" $ARGS \
                            --out out/consumer-patch.md --out-json out/consumer-patch.json
                    else
                        # the published POM of the upstream build; older builds only archived the dependency-reduced one
                        POM=$(ls work/bundle/target/*.pom 2>/dev/null | head -1)
                        [ -n "$POM" ] || POM=work/bundle/target/dependency-reduced-pom.xml
                        "$PY" scripts/gen_consumer_patch.py --manifest out/bundle-manifest.json --reduced-pom "$POM" $ARGS \
                            --out out/consumer-patch.md --out-json out/consumer-patch.json
                    fi
                '''
            }
        }

        stage('Apply patch') {
            when { allOf { expression { params.APPLY }; expression { params.CONSUMER_GIT_URL?.trim() } } }
            steps {
                sh '''
                    "$PY" scripts/apply_consumer_patch.py --patch out/consumer-patch.json --project work/consumer \
                        --out out/consumer-apply.json --diff out/consumer-apply.diff
                    "$PY" -c "import json; print(json.load(open('out/consumer-apply.json'))['branch'])" > out/consumer-apply.branch
                    git -C work/consumer checkout -B "$(cat out/consumer-apply.branch)"
                    echo "--- changes ---"; cat out/consumer-apply.diff
                '''
            }
        }

        stage('Build consumer with the Enforcer gate') {
            when { allOf { expression { params.APPLY }; expression { params.CONSUMER_GIT_URL?.trim() } } }
            steps {
                dir('work/consumer') {
                    script {
                        withNexusCredentials {
                            sh 'mvn -B -ntp -s "$WORKSPACE/work/settings.xml" $CONSUMER_BUILD_ARGS verify'
                        }
                    }
                }
            }
        }

        stage('Verify plugin dependencies') {
            when { allOf { expression { params.APPLY }; expression { params.CONSUMER_GIT_URL?.trim() }; expression { fileExists('out/consumer-plugins.json') } } }
            steps {
                script {
                    // the plugin trees are regenerated from the changed POMs: every patched plugin must see the
                    // bundle and no embedded coordinate beyond the shadowed ones (report only, UNSTABLE)
                    withNexusCredentials {
                        sh '''
                            mvn -B -ntp -s "$WORKSPACE/work/settings.xml" -f work/consumer/pom.xml \
                                org.apache.maven.plugins:maven-help-plugin:3.4.1:effective-pom \
                                -Doutput="$WORKSPACE/out/consumer-effective-pom-after.xml" $CONSUMER_MAVEN_ARGS
                            "$PY" scripts/plugin_trees.py --effective-pom out/consumer-effective-pom-after.xml \
                                --reactor work/plugin-trees-after --plugins-out out/consumer-plugins-after.json
                            mvn -B -ntp -s "$WORKSPACE/work/settings.xml" -f work/plugin-trees-after/pom.xml \
                                org.apache.maven.plugins:maven-dependency-plugin:3.7.1:tree \
                                -Dverbose -DoutputType=text -DappendOutput=true \
                                -DoutputFile="$WORKSPACE/out/consumer-plugin-trees-after.txt"
                            "$PY" scripts/verify_plugin_trees.py --patch out/consumer-patch.json --plugins out/consumer-plugins-after.json \
                                --tree out/consumer-plugin-trees-after.txt --out out/plugin-trees-check.json \
                                --findings-out out/plugin-trees-findings.txt
                        '''
                    }
                    def findings = pluginFindings()
                    if (findings) {
                        echo "Plugin dependency check: ${findings.size()} finding(s):\n - " + findings.join('\n - ')
                        env.PLUGIN_NOTE = "${findings.size()} finding(s), see ${env.BUILD_URL}artifact/out/SUMMARY.md"
                        currentBuild.result = 'UNSTABLE'
                    } else {
                        env.PLUGIN_NOTE = 'every patched plugin sees the bundle and no embedded coordinate beyond the shadowed ones'
                    }
                }
            }
        }

        stage('Verify rebuilt application') {
            when { allOf { expression { params.APPLY }; expression { params.CONSUMER_GIT_URL?.trim() } } }
            steps {
                script {
                    sh '"$PY" scripts/find_app_jar.py --project work/consumer --manifest out/bundle-manifest.json --out out/rebuilt-app.json'
                    def oldRef = params.VERIFY_AGAINST?.trim()
                    if (!oldRef) {
                        oldRef = sh(returnStdout: true, script: '"$PY" -c "import json; print(json.load(open(\'out/rebuilt-app.json\')).get(\'old_ref\') or \'\')"').trim()
                    }
                    if (!oldRef) {
                        echo 'The original artifact is unknown (bundle taken from Nexus and VERIFY_AGAINST empty): equivalence check skipped'
                        env.EQUIVALENCE_NOTE = 'skipped, original artifact unknown'
                        return
                    }
                    fetchSource('old', oldRef)
                    // the comparison reports and never fails the job: its findings are listed in
                    // out/equivalence-findings.txt and decided on before the push (ON_DIFFERENCES)
                    sh '''
                        NEW=$("$PY" -c "import json; print(json.load(open('out/rebuilt-app.json'))['new_jar'])")
                        "$PY" scripts/verify_app_equivalence.py --old-source out/old-source.json --new "$NEW" \
                            --policy config/policy.json --out out/equivalence.json
                        "$PY" scripts/write_summary.py --out-dir out || true
                    '''
                    archiveArtifacts artifacts: 'out/**', allowEmptyArchive: true   // readable while the input step waits
                    def findings = equivalenceFindings().findAll { !it.startsWith('[info]') }
                    if (findings) {
                        echo "The rebuilt application differs from the original artifact in ${findings.size()} way(s):\n - " + equivalenceFindings().join('\n - ')
                        env.EQUIVALENCE_NOTE = "${findings.size()} difference(s) found, see ${env.BUILD_URL}artifact/out/SUMMARY.md"
                        currentBuild.result = 'UNSTABLE'
                    } else {
                        env.EQUIVALENCE_NOTE = "equivalent, only the embedded jars were replaced (${env.BUILD_URL})"
                    }
                }
            }
        }

        stage('Push branch') {
            when {
                allOf {
                    expression { params.APPLY }
                    expression { params.CONSUMER_GIT_URL?.trim() }
                    expression { env.PUSH_BRANCH == 'true' }
                }
            }
            steps {
                script {
                    def branch = readFile('out/consumer-apply.branch').trim()
                    def lines = equivalenceFindings() + pluginFindings()
                    def findings = lines.findAll { !it.startsWith('[info]') }
                    def push = true
                    if (findings && env.ON_DIFFERENCES == 'stop') {
                        echo "ON_DIFFERENCES=stop: there are findings to review (comparison with the original artifact, plugin dependency check), ${branch} is not pushed (the change is archived as out/consumer-apply.diff)"
                        push = false
                    } else if (findings && env.ON_DIFFERENCES != 'push') {
                        try {
                            timeout(time: env.ON_DIFFERENCES_TIMEOUT.toInteger(), unit: 'MINUTES') {
                                input message: "${findings.size()} finding(s) to review before pushing ${branch}:\n - ${lines.join('\n - ')}\n\nFull report: ${env.BUILD_URL}artifact/out/SUMMARY.md\n\nPush ${branch} anyway?",
                                      ok: 'Push the branch'
                            }
                        } catch (err) {
                            echo "${branch} not pushed: declined, or no answer within ${env.ON_DIFFERENCES_TIMEOUT} minutes (${err})"
                            push = false
                        }
                    }
                    if (push) {
                        dir('work/consumer') {
                            withEnv(["EQUIVALENCE_NOTE=${env.EQUIVALENCE_NOTE ?: 'not run'}", "PLUGIN_NOTE=${env.PLUGIN_NOTE ?: 'not run'}"]) {
                                sh '''
                                    git config user.name "$GIT_USER_NAME"
                                    git config user.email "$GIT_USER_EMAIL"
                                    git add -A -- '*pom.xml'
                                    git commit -q -F - <<EOF
Replace bundled dependencies with $(sed 's#^rebundle/##' "$WORKSPACE/out/consumer-apply.branch")

Generated by mvn-rebundle: direct dependencies removed, exclusions added on the
paths that reintroduce embedded coordinates, Enforcer gate installed, build plugins
whose dependencies contained embedded coordinates given the bundle as first dependency.
Comparison with the original artifact: $EQUIVALENCE_NOTE
Plugin dependency check: $PLUGIN_NOTE
EOF
                                '''
                            }
                            withGitCredentials {
                                sh "git push origin HEAD:refs/heads/${branch}"
                            }
                            echo "Pushed ${branch}: open a merge request from it"
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            sh '"$PY" scripts/write_summary.py --out-dir out || true'
            archiveArtifacts artifacts: 'out/**', allowEmptyArchive: true
        }
    }
}
