// mvn-rebundle / verify: compare the Spring Boot artifacts built before and after the POM change.
// Proves that every class and resource on the dependency classpath is byte-identical: only the replaced
// jars disappear, the bundle appears, and the application's own classes are unchanged.
//
// Both inputs may be images or jars. Agent requirements: Python 3.8+; docker or crane for image sources.
// Job setup: "Pipeline script from SCM", Script Path = jenkins/Jenkinsfile.verify.

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        choice(name: 'OLD_SOURCE_TYPE', choices: ['image', 'jar'], description: 'Type of the artifact built before the change')
        string(name: 'OLD_SOURCE_REF', defaultValue: '', description: 'Image reference or jar location of the old build')
        string(name: 'OLD_APP_PATH', defaultValue: '/app/app.jar', description: 'Application path inside the old image')
        choice(name: 'NEW_SOURCE_TYPE', choices: ['image', 'jar'], description: 'Type of the artifact built after the change')
        string(name: 'NEW_SOURCE_REF', defaultValue: '', description: 'Image reference or jar location of the new build')
        string(name: 'NEW_APP_PATH', defaultValue: '/app/app.jar', description: 'Application path inside the new image')
        string(name: 'IMAGE_PLATFORM', defaultValue: '', description: 'Image platform, e.g. linux/amd64; empty uses the default')
        choice(name: 'IMAGE_TOOL', choices: ['auto', 'docker', 'crane'], description: 'Tool used to read the images')
        string(name: 'BUNDLE_ARTIFACT_ID', defaultValue: '', description: 'Optional: restrict bundle detection to this artifactId (default: detected from the manifest)')
    }

    environment {
        PY = 'python3'
    }

    stages {
        stage('Prepare') {
            steps {
                sh 'rm -rf work out && mkdir -p work out && "$PY" --version'
            }
        }

        stage('Fetch old build') {
            steps {
                sh '''
                    "$PY" scripts/extract_source.py --type "$OLD_SOURCE_TYPE" --ref "$OLD_SOURCE_REF" --path "$OLD_APP_PATH" \
                        --image-tool "$IMAGE_TOOL" --platform "$IMAGE_PLATFORM" --out work/old --meta out/old-source.json
                '''
            }
        }

        stage('Fetch new build') {
            steps {
                sh '''
                    "$PY" scripts/extract_source.py --type "$NEW_SOURCE_TYPE" --ref "$NEW_SOURCE_REF" --path "$NEW_APP_PATH" \
                        --image-tool "$IMAGE_TOOL" --platform "$IMAGE_PLATFORM" --out work/new --meta out/new-source.json
                '''
            }
        }

        stage('Compare') {
            steps {
                sh '''
                    "$PY" scripts/verify_app_equivalence.py --old-source out/old-source.json --new-source out/new-source.json \
                        --bundle-artifact-id "$BUNDLE_ARTIFACT_ID" --policy config/policy.json --out out/equivalence.json
                '''
            }
        }
    }

    post {
        always {
            sh '"$PY" scripts/write_summary.py --out-dir out || true'
            archiveArtifacts artifacts: 'out/**', allowEmptyArchive: true
        }
    }
}
