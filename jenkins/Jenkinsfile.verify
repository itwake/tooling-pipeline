// mvn-rebundle / verify: compare the Spring Boot artifacts built before and after the POM change.
// Proves that every class and resource on the dependency classpath is byte-identical: only the replaced
// jars disappear and the bundle appears. Every difference (third-party jars and their contents, the
// project's own modules and classes) is listed with where it sits, together with whether both builds come
// from the same commit; the build ends UNSTABLE when there is anything to review. Nothing is decided here.
//
// Each input is a reference like SOURCE_REF of the main job: an image reference (ECR, the Nexus Docker
// registry or any registry the agent is logged in to; append #/path when the application is not at
// DEFAULT_APP_PATH), Maven coordinates resolved in NEXUS_MAVEN_REPO_URL, an http(s) URL or a path on the
// agent. The kind and the login it needs are detected from the reference.
// Agent requirements: Python 3.8+; docker or crane for images; the aws CLI for images in ECR.
// Job setup: "Pipeline script from SCM", Script Path = jenkins/Jenkinsfile.verify.

// Credentials needed to read a source artifact; `auth` is what `extract_source.py --detect` printed.
def withSourceCredentials(String auth, Closure body) {
    if (auth == 'ecr' && env.AWS_CREDENTIALS_ID?.trim()) {
        withCredentials([aws(credentialsId: env.AWS_CREDENTIALS_ID,
                             accessKeyVariable: 'AWS_ACCESS_KEY_ID', secretKeyVariable: 'AWS_SECRET_ACCESS_KEY')]) {
            body()
        }
    } else if (auth == 'nexus' && env.SOURCE_CREDENTIALS_ID?.trim()) {
        withCredentials([usernamePassword(credentialsId: env.SOURCE_CREDENTIALS_ID,
                                          usernameVariable: 'SOURCE_USERNAME', passwordVariable: 'SOURCE_PASSWORD')]) {
            body()
        }
    } else {
        body()
    }
}

// Detects one reference, binds the credentials it needs and extracts it to work/<label>.
def fetchSource(String label, String ref) {
    def detected = ''
    withEnv(["FETCH_REF=${ref}", "FETCH_LABEL=${label}"]) {
        detected = sh(returnStdout: true,
                      script: '"$PY" scripts/extract_source.py --detect --ref "$FETCH_REF" --nexus-hosts "$NEXUS_HOSTS"').trim()
        echo "${label} source detected: ${detected}"
        withSourceCredentials(detected.tokenize()[1]) {
            sh '''
                "$PY" scripts/extract_source.py --ref "$FETCH_REF" --path "$DEFAULT_APP_PATH" --nexus-hosts "$NEXUS_HOSTS" \
                    --image-tool "$IMAGE_TOOL" --platform "$IMAGE_PLATFORM" --maven-repo-url "$NEXUS_MAVEN_REPO_URL" \
                    --out "work/$FETCH_LABEL" --meta "out/$FETCH_LABEL-source.json"
            '''
        }
    }
}

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        string(name: 'OLD_SOURCE_REF', defaultValue: '', description: 'Artifact built before the change: image reference (#/path optional), Maven coordinates, URL or agent path')
        string(name: 'NEW_SOURCE_REF', defaultValue: '', description: 'Artifact built after the change: same forms')
        string(name: 'BUNDLE_ARTIFACT_ID', defaultValue: '', description: 'Optional: restrict bundle detection to this artifactId (default: detected from the manifest)')
    }

    environment {
        // ---- site specific: edit once -------------------------------------------------------
        NEXUS_MAVEN_REPO_URL  = 'https://nexus.example.com/repository/maven-public/'   // Maven coordinates are resolved here
        NEXUS_DOCKER_REGISTRY = 'nexus-docker.example.com'   // host[:port] of the Nexus Docker registry
        SOURCE_CREDENTIALS_ID = 'nexus-deploy'  // Nexus credential for reading images, URLs and coordinates hosted on Nexus
        AWS_CREDENTIALS_ID    = ''              // images in ECR: AWS credential ID (CloudBees AWS Credentials plugin); empty = the agent's instance role
        DEFAULT_APP_PATH      = '/app/app.jar'  // application path inside images
        IMAGE_PLATFORM        = ''              // e.g. linux/amd64 for multi-arch images; empty = default
        IMAGE_TOOL            = 'auto'          // auto | docker | crane
        // -----------------------------------------------------------------------------------
        NEXUS_HOSTS = "${NEXUS_DOCKER_REGISTRY},${NEXUS_MAVEN_REPO_URL}"
        PY = 'python3'
    }

    stages {
        stage('Prepare') {
            steps {
                sh 'rm -rf work out && mkdir -p work out && "$PY" --version'
            }
        }

        stage('Fetch old build') {
            steps {
                script { fetchSource('old', params.OLD_SOURCE_REF) }
            }
        }

        stage('Fetch new build') {
            steps {
                script { fetchSource('new', params.NEW_SOURCE_REF) }
            }
        }

        stage('Compare') {
            steps {
                sh '''
                    "$PY" scripts/verify_app_equivalence.py --old-source out/old-source.json --new-source out/new-source.json \
                        --bundle-artifact-id "$BUNDLE_ARTIFACT_ID" --policy config/policy.json --out out/equivalence.json
                '''
                script {
                    def lines = fileExists('out/equivalence-findings.txt') ? readFile('out/equivalence-findings.txt').tokenize('\n').findAll { it.trim() } : []
                    def findings = lines.findAll { !it.startsWith('[info]') }
                    if (findings) {
                        echo "The new build differs from the old one in ${findings.size()} way(s):\n - " + lines.join('\n - ')
                        currentBuild.result = 'UNSTABLE'
                    }
                }
            }
        }
    }

    post {
        always {
            sh '"$PY" scripts/write_summary.py --out-dir out || true'
            archiveArtifacts artifacts: 'out/**', allowEmptyArchive: true
        }
    }
}
