// dep-bundle-pipeline / verify —— 比对「改 POM 之前」和「改 POM 之后」构建出的 Spring Boot 制品，
// 证明依赖 classpath 上的每个 class 与资源字节一致：只有被替换的 jar 消失、bundle 出现，应用自身的 class 不变。
//
// 两个输入都可以是镜像或 jar。Agent 要求：Python 3.8+；镜像输入还需要 docker 或 crane。
// Job 配置：Pipeline script from SCM，Script Path = Jenkinsfile.verify。

pipeline {
    agent any

    options {
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 30, unit: 'MINUTES')
    }

    parameters {
        choice(name: 'OLD_SOURCE_TYPE', choices: ['image', 'jar'], description: '修改前的制品类型')
        string(name: 'OLD_SOURCE_REF', defaultValue: '', description: '修改前的镜像引用或 jar 地址')
        string(name: 'OLD_APP_PATH', defaultValue: '/app/app.jar', description: '修改前镜像内的应用路径')
        choice(name: 'NEW_SOURCE_TYPE', choices: ['image', 'jar'], description: '修改后的制品类型')
        string(name: 'NEW_SOURCE_REF', defaultValue: '', description: '修改后的镜像引用或 jar 地址')
        string(name: 'NEW_APP_PATH', defaultValue: '/app/app.jar', description: '修改后镜像内的应用路径')
        string(name: 'IMAGE_PLATFORM', defaultValue: '', description: '镜像平台，例如 linux/amd64；留空用默认')
        choice(name: 'IMAGE_TOOL', choices: ['auto', 'docker', 'crane'], description: '镜像提取工具')
        string(name: 'BUNDLE_ARTIFACT_ID', defaultValue: '', description: '可选：限定 bundle 的 artifactId（默认按 manifest 自动识别）')
    }

    environment {
        PY = 'python3'
    }

    stages {
        stage('Prepare') {
            steps {
                sh 'rm -rf work out && mkdir -p work out && "$PY" --version'
            }
        }

        stage('Fetch old build') {
            steps {
                sh '''
                    "$PY" scripts/extract_source.py --type "$OLD_SOURCE_TYPE" --ref "$OLD_SOURCE_REF" --path "$OLD_APP_PATH" \
                        --image-tool "$IMAGE_TOOL" --platform "$IMAGE_PLATFORM" --out work/old --meta out/old-source.json
                '''
            }
        }

        stage('Fetch new build') {
            steps {
                sh '''
                    "$PY" scripts/extract_source.py --type "$NEW_SOURCE_TYPE" --ref "$NEW_SOURCE_REF" --path "$NEW_APP_PATH" \
                        --image-tool "$IMAGE_TOOL" --platform "$IMAGE_PLATFORM" --out work/new --meta out/new-source.json
                '''
            }
        }

        stage('Compare') {
            steps {
                sh '''
                    "$PY" scripts/verify_app_equivalence.py --old-source out/old-source.json --new-source out/new-source.json \
                        --bundle-artifact-id "$BUNDLE_ARTIFACT_ID" --policy config/policy.json --out out/equivalence.json
                '''
            }
        }
    }

    post {
        always {
            sh '"$PY" scripts/write_summary.py --out-dir out || true'
            archiveArtifacts artifacts: 'out/**', allowEmptyArchive: true
        }
    }
}
